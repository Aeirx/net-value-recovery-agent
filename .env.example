# Copy this file to `.env` and fill in whichever key you have.
#
#   cp .env.example .env
#
# `.env` is gitignored; this template is not. Never put a real key in this file.
# Anything already exported in your shell takes precedence over what is set here.
#
# You need AT MOST ONE of these. The rules and oracle diagnosis arms need none, and a
# populated response cache replays the LLM arm offline with no credentials at all.

# --- Google Gemini -- has a free tier ---------------------------------------------
# https://aistudio.google.com/apikey
# Run with:  --model gemini-2.5-flash
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as an alias, if you already have one set for other tools.
GOOGLE_API_KEY=

# --- xAI Grok ---------------------------------------------------------------------
# https://console.x.ai
# Run with:  --model grok-4.5        (~$0.90 for the full 400-transaction pass)
XAI_API_KEY=

# --- Anthropic --------------------------------------------------------------------
# https://console.anthropic.com
# Run with:  --model claude-opus-5   (~$3.29 for the full pass)
ANTHROPIC_API_KEY=

# --- A model on your own machine -- no key, no bill, no network -------------------
# Install Ollama, then:  ollama pull qwen2.5:7b-instruct
# Run with:  --model local/qwen2.5:7b-instruct
# Only set these to point at a non-default server (llama.cpp, vLLM, LM Studio, or a
# different port). The default is http://localhost:11434/v1
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_API_KEY=not-needed
